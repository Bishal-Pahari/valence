{
  "name": "create-valence",
  "version": "0.3.0",
  "description": "Keep the native core, swap the web shell: your web app as a Flutter app's interface, with signed UI releases that roll back on their own, offline-first SQLite and a typed bridge. One command sets it up.",
  "license": "MIT",
  "author": "Bishal Pahari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bishal-Pahari/valence.git"
  },
  "homepage": "https://getvalence.pages.dev",
  "bugs": {
    "url": "https://github.com/Bishal-Pahari/valence/issues"
  },
  "type": "module",
  "bin": {
    "create-valence": "bin/valence.mjs",
    "valence": "bin/valence.mjs"
  },
  "files": [
    "bin/valence.mjs",
    ".claude/agents/valence-*.md",
    ".claude/skills/valence",
    "!.claude/skills/valence/scripts/*.test.mjs",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test bin/valence.test.mjs .claude/skills/valence/scripts/valence.test.mjs"
  },
  "keywords": [
    "flutter",
    "webview",
    "ota",
    "code-push",
    "offline-first",
    "sqlite",
    "sveltekit",
    "hybrid-app",
    "claude-code"
  ]
}
