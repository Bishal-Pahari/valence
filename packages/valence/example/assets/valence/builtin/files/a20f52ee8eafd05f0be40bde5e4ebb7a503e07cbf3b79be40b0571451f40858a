<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Valence example</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { margin: 0; padding: calc(24px + var(--valence-inset-top, 0px)) calc(24px + var(--valence-inset-right, 0px)) calc(24px + var(--valence-inset-bottom, 0px)) calc(24px + var(--valence-inset-left, 0px)); line-height: 1.5; }
      h1 { font-size: 1.4rem; margin: 0 0 4px; }
      p.sub { margin: 0 0 24px; opacity: 0.7; }
      section { border-top: 1px solid rgba(128, 128, 128, 0.3); padding: 16px 0; }
      button { min-height: 48px; min-width: 48px; font: inherit; padding: 8px 14px; margin-right: 8px; }
      pre { white-space: pre-wrap; word-break: break-word; margin: 8px 0 0; font-size: 0.85rem; }
      li { margin-bottom: 4px; }
    </style>
  </head>
  <body>
    <main>
    <h1>Valence example</h1>
    <pre id="appearance" role="status">Waiting for system appearance</pre>
    <p class="sub">The web UI, served from the host's loopback server as a signed bundle.</p>

    <section>
      <h2>Task restoration</h2>
      <label>Draft <input id="draft" value="fern draft" /></label>
      <button id="save-state">Save draft and route</button>
      <button id="clear-state">Clear draft</button>
      <pre id="restored"></pre>
    </section>

    <section>
      <h2>Host</h2>
      <pre id="info">reading app.info…</pre>
      <pre id="batch">reading data.getMany…</pre>
      <pre id="status">reading sync.status…</pre>
      <pre id="link">No link received</pre>
      <button id="store-update">Open app store</button>
      <button id="read-update">Read update status</button>
      <pre id="store-status" role="status"></pre>
    </section>

    <section>
      <h2>Your own data</h2>
      <p>Written to native SQLite through the bridge, and queued for sync.</p>
      <button id="add">Add a note</button>
      <button id="delete">Delete latest note</button>
      <button id="haptics">Haptic tap</button>
      <ul id="rows"></ul>
      <pre id="error"></pre>
    </section>

    <section>
      <h2>Login and secrets</h2>
      <p>
        The token goes to the host, not into the page's storage: the host attaches it to every sync of
        <code>shelf</code>, including the ones it runs while this page is not on screen.
      </p>
      <label for="token">API token</label>
      <input id="token" placeholder="paste any string as a token" size="24" />
      <input id="account" placeholder="account id (try a, then b)" size="18" />
      <button id="set-token">auth.setToken</button>
      <button id="clear-token">sign out</button>
      <button id="probe">secure.* round trip</button>
      <pre id="auth">reading auth.hasToken…</pre>
      <p>
        Naming a <em>different</em> account clears every writable bucket and the outbox, so the next
        person on this phone does not read the last one's notes. It refuses while a note is still
        queued; tick the box to drop those notes unsent.
      </p>
      <label><input type="checkbox" id="discard" /> discardPending</label>
    </section>

    <section>
      <h2>Lifecycle, connectivity and updates</h2>
      <p>
        Four lifecycle states rather than Flutter's five, connectivity as the OS reports
        <em>interfaces</em> (never reachability), and the reason the last update check ended as it did.
      </p>
      <button id="refresh-state">app.state + bundle.status</button>
      <pre id="state">reading app.state…</pre>
      <pre id="bundle">reading bundle.status…</pre>
      <pre id="events">no lifecycle, connectivity or sync event yet</pre>
    </section>

    <section>
      <h2>Your API</h2>
      <p>Native HTTP to the local reference adapter. Set its bearer token above first.</p>
      <button id="http">http.request</button>
      <button id="http-denied">Try an unlisted origin</button>
      <pre id="http-result"></pre>
    </section>

    <section>
      <h2>Permissions</h2>
      <p>Choose a permission, check it, then request it only when needed.</p>
      <select id="permission-kind" aria-label="Permission kind">
        <option>camera</option><option>location</option><option>notifications</option>
        <option>contacts</option><option>bluetooth</option><option>microphone</option><option>photos</option>
      </select>
      <button id="permission-check">Check</button>
      <button id="permission-request">Request</button>
      <button id="permission-settings">App settings</button>
      <pre id="permission-result" aria-live="polite"></pre>
      <pre id="permission-event" aria-live="polite"></pre>
    </section>


    <section>
      <h2>Local reminders</h2>
      <p>Request permission, then schedule a one-shot reminder 15 seconds from now. Exact requests may return inexact.</p>
      <button id="notify-permission">Allow reminders</button>
      <button id="notify-schedule">Remind in 15 seconds</button>
      <button id="notify-pending">Pending reminders</button>
      <button id="notify-pending-ids">Pending IDs only</button>
      <button id="notify-cancel">Cancel reminder</button>
      <button id="badge">Badge 3</button>
      <pre id="notify-result"></pre>
    </section>

    <section>
      <h2>Remote push</h2>
      <p>Requires a Firebase-configured host. Permission is requested only when you tap.</p>
      <button id="push-check">Check permission</button>
      <button id="push-request">Allow notifications</button>
      <button id="push-token">Check registration</button>
      <pre id="push-result">Push device check blocked: needs Firebase project.</pre>
    </section>


    <section>
      <h2>Share an image</h2>
      <p>Share a PNG from the signed bundle or a small inline image, with a caption.</p>
      <button id="share-bundle">Share bundle image</button>
      <button id="share-inline">Share inline image</button>
      <pre id="share-result"></pre>
    </section>

    </main>
    <!--
      A real app imports @getvalence/bridge through the generated web/lib/bridge.g.ts. This example talks
      to the wire protocol directly, so it needs no bundler and `valence bundle` can sign the folder as is
      — and so this file doubles as the smallest honest description of §4.2.
    -->
    <style>
      :root[data-valence-dark-mode="true"] { color-scheme: dark; }
      :root[data-valence-dark-mode="false"] { color-scheme: light; }
      :root[data-valence-high-contrast="true"] { color: CanvasText; background: Canvas; }
      :root[data-valence-reduced-motion="true"] * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
      :focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
      input { max-width: 100%; box-sizing: border-box; font: inherit; min-height: 48px; }
    </style>
    <script>
      const nonce = document.querySelector('meta[name="valence-nonce"]')?.content ?? '';
      const pending = new Map();
      let nextId = 1;
      let liveLink = false;
      window.__valence = {
        r(reply) {
          const p = pending.get(reply.id);
          if (!p) return;
          pending.delete(reply.id);
          reply.ok ? p.resolve(reply.v) : p.reject(new Error(`${reply.e.code}: ${reply.e.message}`));
        },
        e(name, payload) {
          if (name === 'app.appearance') {
            const css = getComputedStyle(document.documentElement);
            document.getElementById('appearance').textContent = JSON.stringify({ ...payload,
              top: css.getPropertyValue('--valence-inset-top'), bottom: css.getPropertyValue('--valence-inset-bottom'),
              left: css.getPropertyValue('--valence-inset-left'), right: css.getPropertyValue('--valence-inset-right'),
              scale: css.getPropertyValue('--valence-font-scale') });
          }
          if (name === 'link.opened') {
            liveLink = true;
            routeLink(payload);
          }
          if (name === 'permissions.changed') document.getElementById('permission-event').textContent = name + ': ' + JSON.stringify(payload);

          if (name.startsWith('notify.')) document.getElementById('notify-result').textContent = name + ': ' + JSON.stringify(payload);

          if (name === 'push.tokenChanged') document.getElementById('push-result').textContent = 'Registration changed; update your backend.';
          if (name === 'push.received' || name === 'push.tapped') document.getElementById('push-result').textContent = name + ': ' + JSON.stringify(payload.message);
          if (name === 'sync.changed') void refresh();
          // §4.6. Logged rather than acted on, because the point of the three is that they *arrive*:
          // app.lifecycle on the way out as well as in, app.online without asking, and sync.done after
          // every run the host made on its own — including the ones with nothing to report.
          if (name === 'app.lifecycle' || name === 'app.online' || name === 'sync.done') {
            seen.unshift(new Date().toISOString().slice(11, 19) + ' ' + name + ' ' + JSON.stringify(payload));
            document.getElementById('events').textContent = seen.slice(0, 8).join('\n');
            if (name === 'app.lifecycle' || name === 'app.online') void showState();
          }
          // The host fires this when a sync request carrying the token came back 401 (§4.4). A real app
          // refreshes the token here, or shows a login screen.
          if (name === 'auth.expired') document.getElementById('auth').textContent = 'auth.expired: the server rejected the token';
        },
      };

      const call = (m, p = {}) =>
        new Promise((resolve, reject) => {
          const id = nextId++;
          pending.set(id, { resolve, reject });
          window.Valence.postMessage(JSON.stringify({ id, n: nonce, m, p }));
        });

      const seen = [];

      // What the generated client's has() does, written out: this bundle's own schema says when a name
      // arrived, and the host reports the version it was compiled with. Both halves are needed, and
      // app.info().bridge alone is not the gate — it is the *app's* schema version (§4.2, §4.4).
      const SINCE = { 'auth.account': 13 };
      let hostBridge = 0;
      const has = (m) => (SINCE[m] ?? 1) <= hostBridge;

      async function showState() {
        document.getElementById('state').textContent = 'app.state: ' + JSON.stringify(await call('app.state'));
        // Never a request, so it is safe to read on every event: the host is reporting what it already knows.
        document.getElementById('bundle').textContent = 'bundle.status: ' + JSON.stringify(await call('bundle.status'));
      }

      const show = (err) => {
        document.getElementById('error').textContent = err ? String(err) : '';
      };

      async function showRestored() {
        const state = await call('state.restore');
        if (state && typeof state.draft === 'string') document.getElementById('draft').value = state.draft;
        document.getElementById('restored').textContent = location.pathname + location.search + location.hash + '\nstate.restore: ' + JSON.stringify(state);
      }
      document.getElementById('save-state').onclick = async () => {
        history.pushState({}, '', '/shelf/fern?mode=draft#edit');
        await call('state.save', { json: { draft: document.getElementById('draft').value } });
        await showRestored();
      };
      document.getElementById('clear-state').onclick = async () => {
        await call('state.save', { json: null });
        await showRestored();
      };

      function routeLink(link) {
        if (!link) return;
        const target = new URL(link.path, location.origin);
        if (target.origin !== location.origin || !link.path.startsWith('/') || link.path.startsWith('//')) return;
        history.pushState(null, '', link.path);
        document.getElementById('link').textContent = 'Link route: ' + location.pathname + location.search + location.hash;
        console.info('link routed: ' + location.pathname);
        dispatchEvent(new PopStateEvent('popstate'));
      }

      async function refresh() {
        document.getElementById('status').textContent = 'sync.status: ' + JSON.stringify(await call('sync.status'));
        document.getElementById('batch').textContent = 'data.getMany: ' + JSON.stringify(await call('data.getMany', { bucket: 'plants', keys: ['fern', 'missing', 'fern'] }));
        const rows = await call('data.list', { bucket: 'shelf', limit: 20 });
        document.getElementById('rows').innerHTML = rows
          .map((r) => `<li>${r.key} — ${JSON.stringify(r.value)} ${r.usn === -1 ? '(not yet synced)' : ''}</li>`)
          .join('');
      }

      document.getElementById('refresh-state').addEventListener('click', async () => {
        show(null);
        try {
          await showState();
        } catch (e) {
          show(e);
        }
      });

      document.getElementById('add').addEventListener('click', async () => {
        show(null);
        try {
          await call('data.put', { bucket: 'shelf', key: `n-${Date.now()}`, value: { at: new Date().toISOString() } });
          await refresh();
        } catch (e) {
          show(e);
        }
      });

      document.getElementById('haptics').addEventListener('click', async () => {
        show(null);
        if (!has('haptics.tap')) {
          show(new Error('Haptics is unavailable on this host.'));
          return;
        }
        try {
          await call('haptics.tap');
        } catch (e) {
          show(e);
        }
      });

      document.getElementById('delete').addEventListener('click', async () => {
        show(null);
        try {
          const rows = await call('data.list', { bucket: 'shelf', limit: 500 });
          if (rows.length) await call('data.put', { bucket: 'shelf', key: rows.at(-1).key, value: null });
          await refresh();
        } catch (e) {
          show(e);
        }
      });

      async function showAuth(extra = '') {
        const stored = await call('auth.hasToken');
        // has('auth.account') is the gate for the account params too: they have no `since` of their own,
        // and an older host answers E_PARAMS for them (§4.4).
        const who = has('auth.account') ? await call('auth.account') : '(host has no auth.account)';
        document.getElementById('auth').textContent =
          `auth.hasToken: ${stored}\nauth.account: ${who}${extra ? '\n' + extra : ''}`;
      }

      // The account id is whatever the app's own identity for the user is. It is sent only when the host
      // has auth.account; an older one would reject the unknown params and the sign-in would fail.
      function authParams(token) {
        const params = { token };
        if (!has('auth.account')) return params;
        const account = document.getElementById('account').value.trim();
        if (account) params.account = account;
        if (document.getElementById('discard').checked) params.discardPending = true;
        return params;
      }

      document.getElementById('set-token').addEventListener('click', async () => {
        show(null);
        try {
          await call('auth.setToken', authParams(document.getElementById('token').value || 'demo-token'));
          await showAuth('stored in the Keystore; every shelf sync now sends Authorization: Bearer');
          await refresh();
        } catch (e) {
          show(e);
        }
      });

      document.getElementById('clear-token').addEventListener('click', async () => {
        show(null);
        try {
          await call('auth.setToken', authParams(null));
          await showAuth('signed out');
          await refresh();
        } catch (e) {
          show(e);
        }
      });

      // Proves the two halves of §4.4 on a real device: an ordinary key round-trips through the
      // Keystore, and the host's own key is refused — which is why the page can never read the token back.
      document.getElementById('probe').addEventListener('click', async () => {
        show(null);
        const lines = [];
        try {
          await call('secure.set', { key: 'demo', value: `written at ${new Date().toISOString()}` });
          lines.push(`secure.get("demo") → ${await call('secure.get', { key: 'demo' })}`);
          await call('secure.delete', { key: 'demo' });
          lines.push(`after delete → ${await call('secure.get', { key: 'demo' })}`);
        } catch (e) {
          lines.push(`unexpected: ${e}`);
        }
        try {
          await call('secure.get', { key: 'valence.auth.token' });
          lines.push('secure.get("valence.auth.token") → NOT REFUSED, which is a bug');
        } catch (e) {
          lines.push(`secure.get("valence.auth.token") → ${e}`);
        }
        await showAuth(lines.join('\n'));
      });

      for (const [id, url] of [['http', 'http://127.0.0.1:8787/rpc'], ['http-denied', 'https://unlisted.invalid/']]) {
        document.getElementById(id).addEventListener('click', async () => {
          try {
            const response = await call('http.request', { url });
            document.getElementById('http-result').textContent = JSON.stringify(response, null, 2);
          } catch (e) {
            document.getElementById('http-result').textContent = String(e);
          }
        });
      }

      for (const action of ['check', 'request', 'settings']) {
        document.getElementById('permission-' + action).addEventListener('click', async () => {
          const kind = document.getElementById('permission-kind').value;
          try {
            const result = action === 'settings' ? await call('permissions.openSettings') : await call('permissions.' + action, { kind });
            document.getElementById('permission-result').textContent = kind + ': ' + result;
          } catch (e) {
            document.getElementById('permission-result').textContent = String(e);
          }
        });
      }

      for (const [id, method, params] of [
        ['notify-permission', 'notify.permission', () => ({ request: true })],
        ['notify-schedule', 'notify.schedule', () => ({ id: 42, title: 'Valence reminder', body: 'A local reminder from your signed page', at: Date.now() + 15000, exact: true, payload: 'demo', actions: ['done', 'snooze'], image: '' })],
        ['notify-pending', 'notify.pending', () => ({})],
        // A full queue of maximum-size requests is over the reply cap, so the IDs are what a
        // cancel-by-difference refill reads. Schema 16.
        ['notify-pending-ids', 'notify.pendingIds', () => ({})],
        ['notify-cancel', 'notify.cancel', () => ({ id: 42 })],
        ['badge', 'badge.set', () => ({ n: 3 })],
      ]) document.getElementById(id).addEventListener('click', async () => {
        try { document.getElementById('notify-result').textContent = method + ': ' + JSON.stringify(await call(method, params())); }
        catch (e) { document.getElementById('notify-result').textContent = String(e); }
      });

      for (const [id, method, params] of [
        ['push-check', 'push.permission', {}],
        ['push-request', 'push.permission', { request: true }],
        ['push-token', 'push.token', {}],
      ]) {
        document.getElementById(id).addEventListener('click', async () => {
          try {
            const result = await call(method, params);
            document.getElementById('push-result').textContent = method === 'push.token' ? (result ? 'Installation registered (token hidden).' : 'Not registered yet.') : result;
          } catch (error) { document.getElementById('push-result').textContent = String(error); }
        });
      }
      void call('push.initial').then((message) => {
        if (message) document.getElementById('push-result').textContent = 'Initial tap: ' + JSON.stringify(message);
      }).catch(() => {});

      for (const id of ['share-bundle', 'share-inline']) {
        document.getElementById(id).addEventListener('click', async () => {
          try {
            const source = id === 'share-bundle' ? { path: 'share.png' } : { bytes: '' };
            const result = await call('share.image', { ...source, fileName: 'valence.png', caption: 'Valence image sharing' });
            document.getElementById('share-result').textContent = result + ' (selection is not delivery)';
          } catch (e) { document.getElementById('share-result').textContent = String(e); }
        });
      }

      document.getElementById('store-update').addEventListener('click', async () => {
        try { await call('app.openStore'); }
        catch (e) { document.getElementById('store-status').textContent = String(e); }
      });
      document.getElementById('read-update').addEventListener('click', async () => {
        try { document.getElementById('store-status').textContent = JSON.stringify(await call('bundle.status')); }
        catch (e) { document.getElementById('store-status').textContent = String(e); }
      });

      (async () => {
        try {
          const info = await call('app.info');
          await showRestored();
          hostBridge = info.bridge;
          document.getElementById('info').textContent = JSON.stringify(info, null, 2);
          const initialLink = await call('link.initial');
          // A newer intent may arrive while startup awaits any bridge reply.
          if (!liveLink) routeLink(initialLink);
          await refresh();
          await showAuth();
          document.getElementById('notify-result').textContent = 'notify.initial: ' + JSON.stringify(await call('notify.initial'));
          await showState();
        } catch (e) {
          show(e);
        }
        // This is what commits an OTA release. Without it every update rolls back after two launches.
        await call('app.ready');
      })();
    </script>
  </body>
</html>
