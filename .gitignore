packages/valence_push/build/

# Flutter tool crash reports. The Windows runs drop these next to the package whenever a test run
# collides with a stale flutter_tester holding build/native_assets/windows/sqlite3.dll. They are
# local diagnostics, never evidence, and `git add -A` would otherwise sweep them into a commit.
**/flutter_*.log
